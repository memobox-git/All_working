# Video shorts skill. Keep this file on your computer only. Never commit or share it.

# ElevenLabs (voice, music, sound effects)
# Key: elevenlabs.io → Settings → API Keys
ELEVENLABS_API_KEY=
# Your cloned voice. Leave blank and run setup again: it fills this in for you.
ELEVENLABS_VOICE_ID=

# HeyGen (your avatar)
# Key: app.heygen.com → Settings → API
HEYGEN_API_KEY=
# Your avatar: HeyGen → Avatars → your avatar → copy its ID (the ID in the page URL works too)
HEYGEN_AVATAR_ID=

# Where finished videos are saved
OUTPUT_DIR=~/Desktop/shorts
