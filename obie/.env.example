# Copy this file to .env.local for local development, and add the same keys in
# Vercel (Project > Settings > Environment Variables). Never commit real keys.

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
# The "anon" public key (or the newer "publishable" key, sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" secret key. Server only: it bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Anthropic (console.anthropic.com > API Keys) ---
ANTHROPIC_API_KEY=

# --- Transcription (lib/transcribe.ts) ---
# Pick one provider: elevenlabs, deepgram or openai. Only that provider's key is needed.
TRANSCRIBE_PROVIDER=elevenlabs
ELEVENLABS_API_KEY=
DEEPGRAM_API_KEY=
OPENAI_API_KEY=

# --- App ---
# Any long random string. Vercel Cron sends it to /api/worker so only the cron can trigger it.
CRON_SECRET=

# --- Access ---
# Comma-separated emails allowed into /app and the API (defaults to the founder's).
ALLOWED_EMAILS=
