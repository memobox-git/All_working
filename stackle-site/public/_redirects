# Netlify redirects for stackle.io. A rule only applies when no page exists at that path,
# except rules marked with ! (forced).
#
# The old Lovable app moves to app.stackle.io and keeps handling sign-in, checkout, the learner
# dashboard and the tutor/admin tools. 302 (temporary) so it can change later without browsers
# caching the move.

# Accounts and checkout
/auth                        https://app.stackle.io/auth                         302
/auth/*                      https://app.stackle.io/auth/:splat                  302
/signup                      https://app.stackle.io/signup                       302
/academy                     https://app.stackle.io/academy                      302
/academy/*                   https://app.stackle.io/academy/:splat               302
/courses/:id/enrollment-success  https://app.stackle.io/courses/:id/enrollment-success  302

# Learner, tutor and admin areas
/learn                       https://app.stackle.io/learn                        302
/learn/*                     https://app.stackle.io/learn/:splat                 302
/learner                     https://app.stackle.io/learner                      302
/learner/*                   https://app.stackle.io/learner/:splat               302
/tutor/*                     https://app.stackle.io/tutor/:splat                 302
/admin/*                     https://app.stackle.io/admin/:splat                 302
/webinars                    https://app.stackle.io/webinars                     302
/webinars/*                  https://app.stackle.io/webinars/:splat              302
/share/*                     https://app.stackle.io/share/:splat                 302

