# Required for live builds. Without it the app runs in demo mode (replays a recorded build).
ANTHROPIC_API_KEY=
# Optional: model and effort for the build (defaults: claude-opus-5-5, low)
PORTFOLIO_MODEL=claude-opus-5-5
PORTFOLIO_EFFORT=low
# Optional: enables one-click "Publish" to a live Netlify URL (custom domains can then be attached in Netlify)
NETLIFY_AUTH_TOKEN=
# Only needed if your API key isn't scoped to a workspace (the API will say so)
ANTHROPIC_WORKSPACE_ID=
